# Copy this file to .env.local for local development.
# In production these are injected as GitHub Actions repo/environment
# variables and written into .env.production before the build step
# (see .github/workflows/deploy.yml) — never commit real values.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Leave empty for a custom domain; set to "/your-repo-name" for the
# default https://<user>.github.io/<repo>/ GitHub Pages URL.
NEXT_PUBLIC_BASE_PATH=

# Used client-side purely to build the Edge Function URLs.
NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1
